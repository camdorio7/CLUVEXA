# Required: use values from your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; required for contact insertion, jobs and payment webhooks.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
# Optional email delivery; configure a verified Resend sender.
RESEND_API_KEY=
NADORIO_EMAIL_FROM=
NADORIO_REPLY_TO=
# Optional external website and organization-specific integration.
NADORIO_WEBSITE_CONFIGS={}
LINDEX_INTEGRATION_CLUB_ID=
LINDEX_INTEGRATION_URL=
LINDEX_INTEGRATION_SECRET=

# v12 organization subscriptions (use Stripe test mode in staging).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NADORIO_STRIPE_PLANS={}
# v12 delivery confirmation and authenticated worker; see docs/V12-DEPLOYMENT.md.
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
